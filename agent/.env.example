# VaraCore testnet deployment
VARA_ENDPOINT=wss://testnet.vara.network
VARACORE_PROGRAM_ID=0x<testnet_program_id>
PRICE_CONSUMER_TESTNET_PROGRAM_ID=0x<testnet_price_consumer_id>
AGENT_CONSUMER_TESTNET_PROGRAM_ID=0x<testnet_agent_consumer_id>
AGENT_SEED=//Alice
# Path to your Vara keyring JSON wallet file (or 12-word mnemonic string)
PRICE_AGENT_MNEMONIC=/path/to/your/wallet.json

# VaraCore mainnet deployment
VARA_MAINNET_ENDPOINT=wss://rpc.vara.network
VARACORE_MAINNET_PROGRAM_ID=0xe1f8f2999a352f217292c9ddd85211dcda23923daa1b95ecb21ff20bf4d8d078
PRICE_CONSUMER_MAINNET_PROGRAM_ID=0x<mainnet_price_consumer_id>
AGENT_CONSUMER_MAINNET_PROGRAM_ID=0x<mainnet_agent_consumer_id>

# Convenience aliases used by seed-interactions.ts and register-test-agents.ts
# Set to mainnet IDs for demo seeding, testnet IDs for development
PRICE_CONSUMER_PROGRAM_ID=0x<price_consumer_id>
AGENT_CONSUMER_PROGRAM_ID=0x<agent_consumer_id>
